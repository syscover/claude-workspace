#!/usr/bin/env bash
# Opens claude-monitor above the Backlog.md board on the screen of the frontmost Ghostty window.
# Default: splits the current terminal, board below, and runs the monitor in it.
# -w / --window: two new separate windows.
# The monitor keeps a fixed height; the board takes the rest of the usable height.
# Needs Accessibility permission for Ghostty (System Events moves the windows).
set -euo pipefail

usage() {
    echo "usage: claude-workspace [-w|--window] [board-folder]" >&2
    exit 1
}

MODE=split
BOARD_DIR=/Users/carlos/Projects/aurora/aurora-catalyst
for arg in "$@"; do
    case $arg in
        -w | --window) MODE=window ;;
        -h | --help) usage ;;
        -*) echo "claude-workspace: unknown option $arg" >&2; usage ;;
        *) BOARD_DIR=$arg ;;
    esac
done

# Height of the monitor window, title bar included. 228 pt fits 6 sessions plus the table chrome
# with the current Ghostty font; measure again if the font changes.
MONITOR_HEIGHT=${MONITOR_HEIGHT:-228}

# In split mode the script works on its own terminal, found by its tty.
TTY_PATH=""
if [[ $MODE == split ]]; then
    TTY_PATH=$(tty) || { echo "claude-workspace: split mode runs inside a terminal; use --window" >&2; exit 1; }
fi

osascript - "$MODE" "$MONITOR_HEIGHT" "$BOARD_DIR" "$TTY_PATH" >/dev/null <<'APPLESCRIPT'
use framework "AppKit"
use scripting additions

-- Estimated height of a Ghostty title bar; a split pane has none, so it needs this much less.
property titleBar : 28

on run argv
    set mode to item 1 of argv
    set monitorHeight to (item 2 of argv) as integer
    set boardDir to item 3 of argv
    set ttyPath to item 4 of argv

    -- Cocoa measures y from the bottom of the first screen (the one with the menu bar);
    -- System Events measures it from the top of that same screen.
    set allScreens to current application's NSScreen's screens() as list
    set screenHeight to item 2 of item 2 of ((item 1 of allScreens)'s frame()) as integer

    -- System Events only knows window order, and the frontmost Ghostty window is not always
    -- the one this command runs in, so bring that one to the front first.
    if mode is "split" then
        tell application "Ghostty"
            set monitorPane to first terminal whose tty is ttyPath
            repeat with w in windows
                if (count of (terminals of w whose tty is ttyPath)) > 0 then
                    activate window w
                    exit repeat
                end if
            end repeat
        end tell
        delay 0.2
    end if

    -- Open on the screen of the frontmost Ghostty window: the one where this command runs.
    tell application "System Events" to tell process "Ghostty"
        set {wx, wy} to position of window 1
        set {ww, wh} to size of window 1
    end tell
    set cx to wx + ww / 2
    set cy to screenHeight - (wy + wh / 2)
    set target to item 1 of allScreens
    repeat with s in allScreens
        set f to s's frame()
        set {fx, fy} to item 1 of f
        set {fw, fh} to item 2 of f
        if cx ≥ fx and cx < fx + fw and cy > fy and cy ≤ fy + fh then set target to contents of s
    end repeat

    set usable to target's visibleFrame()
    set x to item 1 of item 1 of usable as integer
    set w to item 1 of item 2 of usable as integer
    set h to item 2 of item 2 of usable as integer
    set top to screenHeight - (item 2 of item 1 of usable as integer) - h

    if mode is "window" then
        -- macOS may push the monitor below a menu bar that visibleFrame does not report,
        -- so the board starts where the monitor really ended, not where it was asked to go.
        set {win, monitorY, realHeight} to my openWindow("claude-monitor", boardDir, {x, top, w, monitorHeight})
        set boardTop to monitorY + realHeight
        my openWindow("backlog board", boardDir, {x, boardTop, w, top + h - boardTop})
    else
        tell application "Ghostty"
            split monitorPane direction down with configuration (my shellConfig("backlog board", boardDir))
        end tell
        delay 0.5
        -- The window of this command is the frontmost one now, so that is the one to fill the screen.
        tell application "System Events" to tell process "Ghostty"
            set position of window 1 to {x, top}
            set size of window 1 to {w, h}
            set realHeight to item 2 of (get size of window 1)
        end tell
        delay 0.3
        -- A new split starts at half of the content height; move the divider up to the monitor height.
        set moveUp to round ((realHeight - titleBar) / 2 - (monitorHeight - titleBar))
        tell application "Ghostty"
            perform action ("resize_split:up," & moveUp) on monitorPane
            -- The new split takes the focus; give it back so the monitor gets the keys.
            focus monitorPane
        end tell
    end if
end run

on shellConfig(shellCommand, dir)
    tell application "Ghostty"
        set config to new surface configuration
        -- A login + interactive shell loads PATH (nvm, ~/.local/bin) the same way a normal tab does.
        set command of config to "/bin/zsh -lic " & quoted form of shellCommand
        set initial working directory of config to dir
    end tell
    return config
end shellConfig

on openWindow(shellCommand, dir, frame)
    tell application "Ghostty" to set win to new window with configuration (my shellConfig(shellCommand, dir))
    delay 0.5
    -- The window just created is the frontmost one.
    tell application "System Events" to tell process "Ghostty"
        set position of window 1 to {item 1 of frame, item 2 of frame}
        set size of window 1 to {item 3 of frame, item 4 of frame}
        return {win, item 2 of (get position of window 1), item 2 of (get size of window 1)}
    end tell
end openWindow
APPLESCRIPT

if [[ $MODE == split ]]; then
    exec claude-monitor
fi
